# Must match QUOTATION_TOKEN_SECRET in the CRM backend's environment.
QUOTATION_TOKEN_SECRET=<generate-a-random-secret-key>

# Base URL of the CRM backend (inside the docker network, e.g. http://backend:8000).
CRM_BACKEND_URL=http://backend:8000

# Path inside this container to the mounted Tenants/ folder tree.
TENANT_FILES_ROOT=/app/tenant_files

# Optional comma-separated list of allowed CORS origins for local dev (e.g. http://localhost:5174).
QUOTATION_CORS_ORIGINS=
