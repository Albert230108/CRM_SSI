[Unit]
Description=EDI_CRM WhatsApp service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ssi-edi-server/CRM-SSI/CRM_SSI/whatsapp-service
EnvironmentFile=/home/ssi-edi-server/CRM-SSI/CRM_SSI/whatsapp-service/.env
Environment=NODE_ENV=production
Environment=WHATSAPP_HISTORY_BACKFILL_ENABLED=false
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
User=ssi-edi-server
Group=ssi-edi-server

[Install]
WantedBy=multi-user.target
