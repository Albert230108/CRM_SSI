PORT=3001
API_KEY=change-me
WHATSAPP_CLIENT_ID=swifthk-whatsapp
RECONNECT_DELAY_MS=5000
CRM_WHATSAPP_WEBHOOK_URL=https://crm.example.com/webhooks/whatsapp
CRM_WEBHOOK_SECRET=
CRM_WEBHOOK_TIMEOUT_MS=5000

# Attachments. Outbound files arrive base64-encoded in the JSON body, so the express body
# limit has to clear 25MB of files (~33.4MB encoded) plus escaping overhead.
WHATSAPP_MAX_REQUEST_BODY=40mb
WHATSAPP_MAX_OUTBOUND_ATTACHMENT_BYTES=10485760
WHATSAPP_MAX_OUTBOUND_TOTAL_BYTES=26214400
# Cap on inbound media the service will download and forward to the CRM.
WHATSAPP_MAX_INBOUND_MEDIA_BYTES=10485760
