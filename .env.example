# Database
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=super_secret_password
POSTGRES_DB=crm_db
DATABASE_URL=postgresql://crm_user:super_secret_password@db:5432/crm_db

# Backend Secrets
SECRET_KEY=<generate-a-random-secret-key>
CORS_ORIGINS=http://localhost,http://<your-server-local-ip>

# Email Configuration (used for invite and password reset links)
SMTP_HOST=<your-smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<your-smtp-username>
SMTP_PASSWORD=<your-smtp-password>
SMTP_FROM_EMAIL=noreply@your-domain.com

# Integrations
BEDS24_API_KEY=<your-beds24-api-key>
BEDS24_REFRESH_TOKEN=<your-beds24-refresh-token>
BEDS24_WEBHOOK_SECRET=<your-webhook-secret>
WHATSAPP_SERVICE_URL=<your-whatsapp-service-url>
WHATSAPP_ACCOUNT_A_NAME=Primary WhatsApp
WHATSAPP_ACCOUNT_A_SERVICE_URL=<your-whatsapp-service-url>
WHATSAPP_ACCOUNT_A_API_KEY=<api-key-a>
WHATSAPP_ACCOUNT_B_NAME=Backup WhatsApp
WHATSAPP_ACCOUNT_B_SERVICE_URL=<your-whatsapp-service-url>
WHATSAPP_ACCOUNT_B_API_KEY=<api-key-b>
WHATSAPP_AUTO_SYNC_ENABLED=false
WHATSAPP_SYNC_INTERVAL_SECONDS=300

# Gmail Integration
GOOGLE_OAUTH_CLIENT_ID=<your-google-oauth-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<your-google-oauth-client-secret>
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/api/integrations/gmail/oauth/callback
GMAIL_TOKEN_ENCRYPTION_KEY=<generate-a-fernet-key>
EMAIL_POLL_INTERVAL_SECONDS=14400
# Pub/Sub push notifications (real-time sync; the poller above is an incremental catch-up
# safety net for missed push notifications, not the primary sync path)
GMAIL_PUBSUB_TOPIC=projects/<your-gcp-project-id>/topics/gmail-push-notifications
GMAIL_PUBSUB_WEBHOOK_SECRET=<your-webhook-secret>
GMAIL_WATCH_RENEWAL_INTERVAL_SECONDS=21600

# Gemini AI (AI-assisted replies)
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash

# Frontend
FRONTEND_BASE_URL=https://your-domain.com
VITE_API_BASE_URL=https://your-domain.com
VITE_LOGO_URL=/logo.png

# Quotation Manager handoff (must match QUOTATION_TOKEN_SECRET in quotation-manager/backend/.env)
QUOTATION_TOKEN_SECRET=<generate-a-random-secret-key>
QUOTATION_TOKEN_EXPIRE_MINUTES=60
QUOTATION_MANAGER_URL=https://your-domain.com/quotation
VITE_QUOTATION_API_BASE_URL=https://your-domain.com/quotation-api
# Server-to-server base URL the backend's sales-manager agent uses to reach the quotation
# backend's API (its routes are mounted under /api). On the docker-compose network this is the
# quotation-backend service; override only if you run it elsewhere.
QUOTATION_MANAGER_API_URL=http://quotation-backend:8000

# Quotation PDFs are filed to this bind-mounted local folder by default (see
# ONEDRIVE_STORAGE_ENABLED below) - laid out as
#   {folder}/{check-in year}/{booking}_{first}_{last}
# Mounted read-write into quotation-backend (where PDFs are generated) and read-only into
# backend (which only lists/serves them - the dashboard's Files tile and the Quotation
# Manager's cross-tenant Files search, app/services/tenant_files_storage.py).
TENANT_FILES_HOST_PATH=/path/to/Tenants

# Set to "true" to file quotation PDFs into OneDrive via Microsoft Graph instead of the local
# folder above. Delegated (sign-in) auth, not an app registration - the target folder lives on
# a personal OneDrive account, which only supports sign-in auth. Run
# scripts/onedrive_device_auth.py once to obtain and store the refresh token (in AdminSettings,
# encrypted with the key below) before enabling this.
ONEDRIVE_STORAGE_ENABLED=false
ONEDRIVE_TOKEN_ENCRYPTION_KEY=<generate-a-fernet-key>

# Communication attachments (email + WhatsApp). Host path bind-mounted into the backend
# container; create it before `docker compose up` or Docker makes it root-owned.
# NOTE: this directory is not part of the Postgres backup - restoring the database alone
# will leave attachment rows pointing at files that no longer exist.
ATTACHMENTS_HOST_PATH=/var/lib/crm-attachments
ATTACHMENT_MAX_FILE_BYTES=10485760
# WhatsApp cap. Email uses its own, lower cap because Gmail's raw send tops out near 35MB
# and 25MB of files base64-encodes to ~33.3MB before headers and the quoted thread body.
ATTACHMENT_MAX_MESSAGE_BYTES=26214400
ATTACHMENT_MAX_EMAIL_MESSAGE_BYTES=20971520
# Cap on a single attachment sent inline to Gemini for the AI planner to read; independent of the send-size caps above.
GEMINI_ATTACHMENT_MAX_INLINE_BYTES=15728640
