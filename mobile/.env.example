# Base URL of the CRM_SSI backend the app connects to.
# EXPO_PUBLIC_ vars are inlined into the client bundle at build time — do NOT put secrets here.
# The app falls back to https://ssi-crm.theworkpc.com when this is unset (see src/config.ts).
EXPO_PUBLIC_API_BASE_URL=https://ssi-crm.theworkpc.com
